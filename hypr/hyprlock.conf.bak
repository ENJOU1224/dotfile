# BACKGROUND
background {
    monitor =
    path = screenshot
    #path = /home/enjou/Pictures/BingWallpaper/20241001-HalfDomeYosemite_ROW8093920979_UHD.jpg
    color = rgba(17, 17, 17, 1.0)
    blur_passes = 3
    blur_size = 7
    noise = 0.0117
    contrast = 0.8916
    brightness = 0.8172
    vibrancy = 0.1696
    vibrancy_darkness = 0.0
    reload_time = -1
    reload_cmd = 
    crossfade_time = -1.0
    zindex = -1
}

# GENERAL
general {
    grace = 0
    hide_cursor = false
    ignore_empty_input = false
    immediate_render = false
    text_trim = true
    fractional_scaling = 2
    screencopy_mode = 0
    fail_timeout = 2000
}

# AUTH
auth {
    pam:enabled = true
    pam:module = hyprlock
    fingerprint:enabled = false
    fingerprint:ready_message = (Scan fingerprint to unlock)
    fingerprint:present_message = Scanning fingerprint
    fingerprint:retry_delay = 250
}

# ANIMATIONS
animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fade, 1, 1.8, linear
}

input-field {
    monitor =
    size = 300, 50
    outline_thickness = 0

    dots_size = 0.26 # Scale of input-field height, 0.2 - 0.8
    dots_spacing = 0.64 # Scale of dots' absolute size, 0.0 - 1.0
    dots_center = true
    dots_rounding = -1
    dots_text_format = 

    rounding = 22
    outer_color = rgba(1, 1, 1, 0.3)
    #inner_color = rgba(100, 114, 125, 0.3)
    inner_color = rgba(216, 216, 216, 0.3)
    font_color = rgb(200, 200, 200)
    font_family = Noto Sans
    fade_on_empty = true
    fade_timeout = 350
    placeholder_text = <i>Enter Password</i> # Text rendered in the input box when it's empty.
    hide_input = false
    hide_input_base_color = rgba(153, 170, 187)
    check_color = rgba(204, 136, 34, 1.0)
    check_text = 
    fail_color = rgba(204, 34, 34, 1.0)
    fail_text = <i>$FAIL <b>($ATTEMPTS)</b></i>
    capslock_color = 
    numlock_color = 
    bothlock_color = 
    invert_numlock = false
    swap_font_color = false

    position = 0, 120
    halign = center
    valign = bottom
}

# Time
label {
    monitor =
    text = cmd[update:1000] echo "<span>$(date +"%H:%M")</span>"
    text_align = center
    color = rgba(216, 222, 233, 0.85)
    font_size = 500
    font_family = Misans Medium
    rotate = 0
    shadow_passes = 10
    shadow_size = 10
    shadow_color = rgb(0,0,0)
    shadow_boost = 1.2
    position = 0, 0
    halign = center
    valign = center
    zindex = 0
    onclick = 
}

